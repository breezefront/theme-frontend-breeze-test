<?php
/**
 * Breeze Theme Editor — PHP Preview Demo Panel
 *
 * This template overrides the page header to show a debug panel at the top
 * of every page. The panel displays the current value of all PHP-only settings
 * (those without a `property` / CSS variable in settings.json) and CSS-var
 * settings so you can verify live-preview behaviour in the Theme Editor.
 *
 * PHP-only settings (section "php_test"):
 *   - Changes trigger a debounced iframe reload (800 ms) in the editor.
 *   - The new value is passed via the `bte_php_preview` cookie and read here
 *     by $breezeThemeEditor->get() before the DB lookup.
 *
 * CSS-var settings (section "css_test"):
 *   - Changes are injected instantly into #bte-live-preview <style>.
 *   - After a PHP-only reload the CSS changes are re-applied on top automatically.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Swissup\BreezeThemeEditor\Api\View\Helper\BreezeThemeEditorInterface|null $breezeThemeEditor
 */

$toggleFlag   = $breezeThemeEditor?->get('php_test/toggle_flag')   ?? '(null)';
$selectLayout = $breezeThemeEditor?->get('php_test/select_layout') ?? '(null)';
$textValue    = $breezeThemeEditor?->get('php_test/text_value')    ?? '(null)';
$numberCols   = (int) ($breezeThemeEditor?->get('php_test/number_cols') ?? 4);
$isOn         = $breezeThemeEditor?->is('php_test/toggle_flag', 'true') ?? false;
?>
<div class="bte-demo-panel"
     style="
         background: var(--bte-test-bg, #1e1e2e);
         color: var(--bte-test-color, #cdd6f4);
         font: var(--bte-test-font-size, 13px) / 1.6 monospace;
         padding: 10px 16px;
         border-bottom: 2px solid #89b4fa;
         display: flex;
         flex-wrap: wrap;
         gap: 12px;
         align-items: center;
     ">

    <strong style="color:#89b4fa;white-space:nowrap">BTE Demo</strong>

    <span>
        <span style="opacity:.6">toggle_flag:</span>
        <b><?= $escaper->escapeHtml($toggleFlag) ?></b>
        <?php if ($isOn): ?>
            &nbsp;<span style="color:#a6e3a1">✓ ON</span>
        <?php else: ?>
            &nbsp;<span style="color:#f38ba8">✗ OFF</span>
        <?php endif; ?>
    </span>

    <span>
        <span style="opacity:.6">select_layout:</span>
        <b><?= $escaper->escapeHtml($selectLayout) ?></b>
        <?php if ($selectLayout === 'list'): ?>
            &nbsp;<span style="color:#fab387">⊟ list</span>
        <?php elseif ($selectLayout === 'masonry'): ?>
            &nbsp;<span style="color:#cba6f7">⊞ masonry</span>
        <?php else: ?>
            &nbsp;<span style="color:#89dceb">⊞ grid</span>
        <?php endif; ?>
    </span>

    <span>
        <span style="opacity:.6">text_value:</span>
        <b>"<?= $escaper->escapeHtml($textValue) ?>"</b>
    </span>

    <span>
        <span style="opacity:.6">number_cols:</span>
        <b><?= $escaper->escapeHtml((string) $numberCols) ?></b>
        &nbsp;<span style="color:#f9e2af">(products-grid--<?= $escaper->escapeHtml((string) $numberCols) ?>-col)</span>
    </span>

    <span style="margin-left:auto;opacity:.5;font-size:.9em">
        CSS vars: --bte-test-bg / --bte-test-color / --bte-test-font-size
    </span>
</div>

<div class="bte-test-hello">Hello World</div>

<?php
// Render the original header content from the parent theme.
// The debug panel sits above the real header markup.
echo $block->getChildHtml();
?>
